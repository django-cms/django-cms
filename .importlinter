# ---------------------------------------------------------------------------
# django CMS import contracts  (RFC _CMS6_RFC.md, step 0)
#
# These contracts encode the *target* container/layer architecture against the
# *current* tree. They are a scoreboard, not a description of today's code.
#
#   Run:      lint-imports
#   Verbose:  lint-imports --verbose
#
# Every entry under `ignore_imports` is a known violation that the RFC retires
# at a named step. The comment block above each contract says which. Removing
# an `ignore_imports` line is how a step proves it is done -- never add a new
# one without a corresponding note.
#
# import-linter fails on an `ignore_imports` entry that matches nothing, so the
# grandfathered list cannot rot: fix the import and the run tells you to delete
# the line. Treat that failure as the success signal it is.
#
# Known blind spot: `from cms.models import Page` imports the `cms.models`
# package facade, not `cms.pages.models.page`, so container boundaries inside
# that facade are invisible to these contracts until step 7 splits the models
# into per-container modules and turns `cms.models` into a shim. Contracts
# therefore name concrete submodules wherever possible.
#
# `allow_indirect_imports = True` on every forbidden contract keeps the report
# at "which file directly imports what it should not". Without it every module
# reaches every other through the `cms.models` / `cms.api` facades and the
# output is unreadable.
# ---------------------------------------------------------------------------

[importlinter]
root_packages =
    cms
    menus

# ---------------------------------------------------------------------------
# Container: menus  (RFC 6.3)
# The menu framework must stand alone on top of `shared` (cms.utils.conf/i18n).
#
# Retired by: step 1 -- splitting cms/toolbar/utils.py moves the editing-URL
# helpers to `shared`, so menus.utils no longer reaches into the toolbar.
# ---------------------------------------------------------------------------
[importlinter:contract:menus-standalone]
name = menus does not reach into cms internals
type = forbidden
allow_indirect_imports = True
source_modules =
    menus
forbidden_modules =
    cms.admin
    cms.api
    cms.models
    cms.core.rendering
    cms.templatetags
    cms.toolbar
    cms.toolbar_pool

# ---------------------------------------------------------------------------
# Container: core -> pages  (RFC 6.1)
# The placeholder/plugin core must not know that pages exist.
#
# Retired by: step 8 (the render_object_* endpoints move from cms.views into
# core.editing, RFC 7.2). cms.core.cache is core's own cache and only
# sits under cms.cache until step 7 re-homes it.
#
# Step 3 retired the Placeholder -> PageContent import: `Placeholder.page` now
# asks cms.shared.resolvers, and pages provides the lookup.
# ---------------------------------------------------------------------------
[importlinter:contract:core-not-pages]
name = core does not depend on pages
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.core.admin.placeholder
    cms.core.cache
    cms.core.models.aliasplugin
    cms.core.models.placeholder
    cms.core.models.placeholderplugin
    cms.core.models.plugin
    cms.operations
    cms.core.plugin_base
    cms.core.plugin_pool
    cms.core.rendering
    cms.core.placeholders
    cms.core.plugins
forbidden_modules =
    cms.pages.admin.page
    cms.appresolver
    cms.cache
    cms.cms_menus
    cms.pages.models.content
    cms.pages.models.page
    cms.page_rendering
    cms.utils.page
    cms.views
    menus
ignore_imports =
    cms.core.admin.placeholder -> cms.views

# ---------------------------------------------------------------------------
# Container: core -> permissions  (RFC 7.1.1)
# Permission policy belongs in services, resolved through a contract, not in
# the core model and renderer.
#
# Retired by: step 5 (services enforce) and step 6 (permission backend).
# ---------------------------------------------------------------------------
[importlinter:contract:core-not-permissions]
name = core does not depend on permissions
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.core.admin.placeholder
    cms.core.models.placeholder
    cms.core.models.plugin
    cms.core.plugin_base
    cms.core.plugin_pool
    cms.core.rendering
    cms.core.placeholders
    cms.core.plugins
forbidden_modules =
    cms.permissions.cache
    cms.permissions.models
    cms.permissions.page_permissions
    cms.permissions.utils
ignore_imports =
    cms.core.models.placeholder -> cms.permissions.utils
    cms.core.rendering -> cms.permissions.utils
    cms.core.plugins -> cms.permissions.utils

# ---------------------------------------------------------------------------
# Container: core -> toolbar  (RFC 6.5.1)
# The toolbar sits above core. Core reaches it today only for the structure-
# mode JSON helpers, which are core's own code living in the wrong file.
#
# Retired by: step 1 -- get_plugin_tree & co. move to core.editing.
# ---------------------------------------------------------------------------
[importlinter:contract:core-not-toolbar]
name = core does not depend on the toolbar container
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.core.admin.placeholder
    cms.core.models.placeholder
    cms.core.models.plugin
    cms.core.plugin_base
    cms.core.plugin_pool
    cms.core.rendering
    cms.core.placeholders
    cms.core.plugins
forbidden_modules =
    cms.cms_toolbars
    cms.toolbar
    cms.toolbar_base
    cms.toolbar_pool
# Both remaining entries are `get_toolbar_from_request` only -- toolbar *state*,
# which the plugin endpoints and the renderer genuinely need. Retired by step 8,
# when those endpoints move into cms.core.editing (a presentation layer, which
# may use the toolbar framework).
ignore_imports =
    cms.core.admin.placeholder -> cms.toolbar.utils
    cms.core.rendering -> cms.toolbar.utils

# ---------------------------------------------------------------------------
# Container: toolbar  (RFC 6.5.3)
# The toolbar framework and chrome must not import pages or permissions; they
# reach both through contracts.
#
# `cms.core` is deliberately NOT forbidden: RFC 5.0 puts the toolbar *above*
# core, because the clipboard is a Placeholder and the toolbar owns the content
# renderers. Listing it here was an error that only surfaced once
# cms.plugin_rendering moved into the core package.
#
# Still partly blind: `from cms.models import PageContent` resolves through the
# facade shim, so a page import can hide there. Re-check once callers stop
# importing the facade.
# ---------------------------------------------------------------------------
[importlinter:contract:toolbar-not-pages]
name = toolbar does not depend on pages or permissions
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.toolbar
    cms.toolbar_base
    cms.toolbar_pool
forbidden_modules =
    cms.admin
    cms.api
    cms.appresolver
    cms.core.admin
    cms.pages.admin
    cms.permissions.admin
    cms.cache.page
    cms.cms_toolbars
    cms.pages.models.content
    cms.pages.models.page
    cms.permissions.models
    cms.pages
    cms.permissions.page_permissions
    cms.permissions.utils

# ---------------------------------------------------------------------------
# Container: pages -> menus  (RFC 6.3)
# The pages model layer must not call into the menu framework; cache
# invalidation becomes a signal / the menu_invalidation contract.
#
# Retired by: step 2.
# ---------------------------------------------------------------------------
[importlinter:contract:pages-model-not-menus]
name = the pages model does not call the menu framework
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.pages.models.content
    cms.pages.models.page
forbidden_modules =
    menus

# ---------------------------------------------------------------------------
# Container: permissions  (RFC 6.2)
# Permissions is the most nearly isolated container and must stay that way.
#
# Retired by: step 6 -- has_plugin_permission moves behind the contract
# instead of reaching into the plugin pool.
# ---------------------------------------------------------------------------
[importlinter:contract:permissions-isolated]
name = permissions does not reach into core, pages or the toolbar
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.permissions.cache
    cms.permissions.models
    cms.permissions.page_permissions
    cms.permissions.utils
forbidden_modules =
    cms.admin
    cms.cache.page
    cms.pages.models.content
    cms.pages.models.page
    cms.core.plugin_base
    cms.core.plugin_pool
    cms.core.rendering
    cms.templatetags
    cms.toolbar
ignore_imports =
    cms.permissions.utils -> cms.core.plugin_pool

# ---------------------------------------------------------------------------
# Layer: model  (RFC 5.1)
# Models must not import upwards. This contract is already KEPT -- it exists
# to stop it regressing.
# ---------------------------------------------------------------------------
[importlinter:contract:model-layer]
name = the model layer does not import admin, toolbar, templatetags or menus
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.core.models
    cms.models
    cms.pages.models
    cms.permissions.models
forbidden_modules =
    cms.admin
    cms.core.admin
    cms.pages.admin
    cms.permissions.admin
    cms.api
    cms.templatetags
    cms.toolbar
    cms.toolbar_pool
    menus

# ---------------------------------------------------------------------------
# Layer: shared  (RFC 5, `contrib` / `shared`)
# cms.utils is the de-facto shared package. Nothing in it may import a layer
# above it.
#
# Retired by: step 5 (cms.core.plugins -> cms.api becomes a service call),
# step 7 (helpers/placeholder re-homed into core; is_editable_model and the
# declared-placeholder scan are core, not shared).
# ---------------------------------------------------------------------------
[importlinter:contract:shared-layer]
name = shared utilities do not import admin, api, toolbar or templatetags
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.utils
forbidden_modules =
    cms.admin
    cms.api
    cms.templatetags
    cms.toolbar
ignore_imports =
    cms.utils.helpers -> cms.core.admin.placeholder
    cms.core.placeholders -> cms.templatetags.cms_tags
    cms.core.plugins -> cms.api

# ---------------------------------------------------------------------------
# Layer: core.editing  (RFC 7.2)
# The frontend editor is generic over the edited model: a model becomes
# editable by registering in its cms_config.py, never by the editor importing
# it. As a presentation layer this package may use the toolbar framework --
# that is why it is not a source of the `core-not-toolbar` contract.
# ---------------------------------------------------------------------------
[importlinter:contract:core-editing-generic]
name = the frontend editor does not know about any particular container
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.core.editing
forbidden_modules =
    cms.pages.admin.page
    cms.appresolver
    cms.cache.page
    cms.cms_menus
    cms.pages.models.content
    cms.pages.models.page
    cms.permissions.models
    cms.page_rendering
    cms.utils.page
    cms.permissions.page_permissions
    menus

# ---------------------------------------------------------------------------
# Package: cms.shared  (RFC 5)
# Helpers every container may use, that depend on no container.
#
# Retired by: a later step -- get_object_for_language keeps a PageContent fast
# path, which becomes a registered hook.
# ---------------------------------------------------------------------------
[importlinter:contract:shared-depends-on-nothing]
name = shared depends on no container
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.shared
forbidden_modules =
    cms.admin
    cms.api
    cms.cms_menus
    cms.core
    cms.models
    cms.core.plugin_base
    cms.core.plugin_pool
    cms.core.rendering
    cms.templatetags
    cms.toolbar
    menus
ignore_imports =
    cms.shared.editing_urls -> cms.models

# ---------------------------------------------------------------------------
# Container: pages toolbar  (RFC 6.5.2)
# PageToolbar contributes to the shared menus by identifier, through the
# pool-owned toolbar object. It may use the toolbar framework -- it is a
# presentation layer -- but must not reach into the chrome classes.
# ---------------------------------------------------------------------------
[importlinter:contract:pages-toolbar-contributes]
name = the page toolbar contributes to the chrome, it does not reach into it
type = forbidden
allow_indirect_imports = True
source_modules =
    cms.pages.toolbar
forbidden_modules =
    cms.cms_toolbars
    cms.toolbar.chrome.AppearanceToolbar
    cms.toolbar.chrome.BasicToolbar
    cms.toolbar.chrome.HelpToolbar
